# Copy to desktop/.env (ignored). Do not commit real credentials.
# Electron does not read IntelliJ's run configuration or infra/mysql/.env.
DB_URL=jdbc:mysql://127.0.0.1:3306/onfilm_api
DB_USER=onfilm_api_app
DB_PASSWORD=
# Use a strong persistent secret (at least 32 bytes), not a new value on every start.
JWT_SECRET=
# Must match the separately running Worker's callback secret.
MEDIA_ENCODE_CALLBACK_SECRET=
# Existing media root, WITHOUT the onfilm-media bucket suffix; use an absolute path.
# macOS example: /Users/your-name/Desktop/onfilm/local-storage
# Windows example: C:/Users/your-name/AppData/Local/OnFilm/media
LOCAL_STORAGE_ROOT=
ONFILM_API_PORT=8080
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Optional: full path to java/java.exe if Java 17+ is not on PATH.
# ONFILM_JAVA_PATH=
# Optional: defaults to ../build/libs/onfilm-0.0.1-SNAPSHOT.jar relative to desktop/.
# ONFILM_API_JAR=
